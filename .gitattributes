# Normaliza los fines de linea: LF en el repositorio, nativo al hacer
# checkout. Evita diffs falsos entre Windows y Linux.
* text=auto eol=lf

# Archivos que deben conservar CRLF en Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: git no debe tocarlos.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Marca los lockfiles como generados para que no ensucien los diffs.
package-lock.json linguist-generated=true
