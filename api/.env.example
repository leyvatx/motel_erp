DJANGO_SECRET_KEY=change-me-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

DATABASE_URL=postgres://motel:motel@localhost:5432/motel_erp
DB_CONN_MAX_AGE=60

# Solo las usa docker-compose.prod.yml para levantar y respaldar PostgreSQL.
# DATABASE_URL tiene que apuntar a estos mismos datos.
POSTGRES_DB=motel_erp
POSTGRES_USER=motel
POSTGRES_PASSWORD=motel
BACKUP_RETENTION_DAYS=14
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=django-db
CACHE_URL=redis://localhost:6379/2

JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7
LOGIN_THROTTLE_RATE=20/min
REPORT_THROTTLE_RATE=60/min

BUSINESS_TIME_ZONE=America/Tijuana
BUSINESS_CURRENCY=MXN
BUSINESS_NAME=Motel Demo
BUSINESS_ADDRESS=
TICKET_FOOTER=Gracias por su visita
EXPIRATION_WARNING_MINUTES=15
EXPENSE_APPROVAL_THRESHOLD=1000.00

PRINTER_BACKEND=dummy
PRINTER_HOST=192.168.1.100
PRINTER_PORT=9100
PRINTER_USB_VENDOR_ID=0x04b8
PRINTER_USB_PRODUCT_ID=0x0202
PRINTER_FILE_PATH=tickets.txt
